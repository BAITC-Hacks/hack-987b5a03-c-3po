# Runtime mode
DEMO_MODE=true
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI live mode
# Keep the real key only in the ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOOL_CALLS=12

# Application
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# Local data and persistence
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
DATABASE_URL=sqlite:///./aml_agent.db
